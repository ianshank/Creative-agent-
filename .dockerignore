# Keep the build context small and free of local state. Anything not needed to install
# the package or run the suite stays out — a smaller context also means fewer chances of
# shipping a developer's local config or review state into an image.

# .github stays in the context on purpose: the test stage asserts that `make gate`
# still covers every check ci.yml runs, which means reading the workflow.
.git
.venv
**/__pycache__
**/*.py[cod]
*.egg-info
dist
build

# Tooling caches
.pytest_cache
.mypy_cache
.ruff_cache
.hypothesis
.mutmut-cache
mutants
htmlcov
coverage.xml
.coverage
.coverage.*

# Local state and secrets
config/settings.yaml
.env
docs/review-log/*
!docs/review-log/.gitkeep

# Editor and OS noise
.idea
.vscode
.DS_Store

# `Dockerfile` COPYs `.claude`, and a subagent worktree under it is a second full checkout
# — including any local `config/settings.yaml` inside it, which the root-level rule above
# does not reach. `.gitignore` already excludes it; these three keep the two files agreeing
# about what is build output (DEC-F35).
.claude/worktrees
.diff_cover*
.import_linter_cache
